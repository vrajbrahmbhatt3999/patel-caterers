# ==============================================================================
# PATEL CATERERS - BLUEHOST MAINTENANCE MODE CONFIGURATION
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ----------------------------------------------------------------------------
  # 1. Allow maintenance page and essential static assets (logo, fonts, icons)
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
  RewriteCond %{REQUEST_URI} !^/assets/ [NC]
  RewriteCond %{REQUEST_URI} !^/favicon\.png$ [NC]

  # ----------------------------------------------------------------------------
  # 2. (Optional) Whitelist your own IP address so you can view the live site:
  # Uncomment the line below and replace with your public IP:
  # RewriteCond %{REMOTE_ADDR} !^123\.456\.789\.000$
  # ----------------------------------------------------------------------------

  # ----------------------------------------------------------------------------
  # 3. Route all traffic to maintenance.html with HTTP 503 (SEO friendly)
  # When ready to turn off maintenance, add '#' at the start of the next line:
  # ----------------------------------------------------------------------------
  RewriteRule ^(.*)$ /maintenance.html [R=503,L]
</IfModule>

# Display maintenance.html on 503
ErrorDocument 503 /maintenance.html

# Tell search engine bots to check back in 1 hour
<IfModule mod_headers.c>
  Header always set Retry-After "3600"
</IfModule>
